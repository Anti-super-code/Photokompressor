<Window x:Class="Photokompressor.UI.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Photokompressor"
        Width="596" Height="656"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="{StaticResource AppFont}"
        FontWeight="Light"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="Manual">

    <!-- Drag handling lives on the card, not just the header: any click that reaches
         here has passed over the background rather than a control, because the buttons
         and the scrollbar all mark the event handled first. -->
    <Border Margin="18" CornerRadius="28" Background="{StaticResource Bg}"
            MouseLeftButtonDown="OnChromeDrag">
        <Border.Effect>
            <DropShadowEffect Color="#243044" Direction="270" ShadowDepth="7" BlurRadius="34" Opacity="0.3"/>
        </Border.Effect>

        <Grid Margin="26,20,26,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Grid.Row="0" Background="Transparent" Margin="0,0,0,16">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="COMPRESSING" Style="{StaticResource Wordmark}"/>
                    <TextBlock x:Name="CountText" FontSize="13" Foreground="{StaticResource TextLo}"
                               Margin="2,4,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        ToolTip="Close" Click="OnCancelClicked"/>
            </Grid>

            <!-- results -->
            <!-- Reaches past the card padding so the row shadows aren't shaved off at
                 the clip boundary; the list margins the content back into alignment. -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="-13,0">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
                </ScrollViewer.Resources>
                <ItemsControl x:Name="ResultsList" Margin="13,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ResultCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextHi}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="11.5"
                                                   Foreground="{StaticResource TextLo}" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Border x:Name="badge" Grid.Column="1" CornerRadius="10" Padding="10,4"
                                            Margin="12,0,0,0" VerticalAlignment="Center"
                                            Background="{StaticResource Sunken}">
                                        <TextBlock x:Name="badgeText" Text="{Binding Badge}" FontSize="12.5"
                                                   FontWeight="SemiBold" Foreground="{StaticResource TextLo}"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Done">
                                    <Setter TargetName="badge" Property="Background" Value="{StaticResource Accent}"/>
                                    <Setter TargetName="badgeText" Property="Foreground" Value="White"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Kept">
                                    <Setter TargetName="badge" Property="Background" Value="#FFF3DC"/>
                                    <Setter TargetName="badgeText" Property="Foreground" Value="{StaticResource Warn}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Failed">
                                    <Setter TargetName="badge" Property="Background" Value="#FFE6E4"/>
                                    <Setter TargetName="badgeText" Property="Foreground" Value="{StaticResource Danger}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- progress + totals -->
            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <ProgressBar x:Name="OverallProgress" Style="{StaticResource NeuProgress}"/>
                <TextBlock x:Name="TotalsText" FontSize="20" FontWeight="Normal" Margin="2,14,0,0"
                           Foreground="{StaticResource TextHi}"/>
            </StackPanel>

            <!-- footer -->
            <Grid Grid.Row="3" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="BackButton" Content="Back" Style="{StaticResource SoftButton}"
                            Width="104" IsEnabled="False" Click="OnBackClicked"/>
                    <Button x:Name="OpenFolderButton" Content="Open output folder"
                            Style="{StaticResource SoftButton}" Width="178" Margin="10,0,0,0"
                            IsEnabled="False" Click="OnOpenFolderClicked"/>
                </StackPanel>
                <Button x:Name="CancelButton" Content="Cancel" HorizontalAlignment="Right"
                        Style="{StaticResource AccentButton}" Width="140" Click="OnCancelClicked"/>
            </Grid>
        </Grid>
    </Border>
</Window>
