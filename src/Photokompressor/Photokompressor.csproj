<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\photokompressor.ico</ApplicationIcon>
    <AssemblyTitle>Photokompressor</AssemblyTitle>
    <Version>1.0.0</Version>
    <!-- WFAC010: WinForms analyzer objects to DPI settings in the manifest, but
         WPF is the real UI stack here and reads them from the manifest. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded UI font: dropping other .ttf files here picks them up automatically. -->
    <Resource Include="Assets\Fonts\*.ttf"/>
  </ItemGroup>

  <ItemGroup>
    <!-- UseWindowsForms is only for Microsoft.VisualBasic's recycle-bin API;
         keep its namespaces out of scope so WPF/NetVips types stay unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.16.0" />
    <PackageReference Include="NetVips" Version="3.2.0" />
    <PackageReference Include="NetVips.Native.win-x64" Version="8.18.4" />
  </ItemGroup>

</Project>
